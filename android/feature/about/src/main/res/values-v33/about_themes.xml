<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 13+: show the icon on the splash however the app is started (a notification, the
         shell), so SplashReveal always starts from the icon. -->
    <style name="Theme.Beamline.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/about_splash_land</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Beamline.AfterSplash</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
